generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Authentication Schema
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  /// Optional handle, stored lowercase
  username     String?       @unique
  /// Optional mobile number
  phone        String?
  passwordHash String
  avatarUrl    String?
  isActive     Boolean       @default(true)
  roleId       String
  role         Role          @relation(fields: [roleId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  articles     BlogArticle[] @relation("AuthorArticles")
  caseStudies  CaseStudy[]   @relation("CaseStudyCreator")
  products     Product[]     @relation("ProductCreator")
  clients      Client[]      @relation("ClientCreator")
  adminIpAddresses AdminIpAddress[] @relation("IpCreatedBy")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // e.g. "Super Admin", "Editor", "Author", "Viewer"
  description String?
  /// Full access to every module and record (bypasses the permission matrix)
  fullAccess  Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  module      String           // e.g. "blogs", "case_studies", "products", "users", "settings"
  action      String           // e.g. "create", "read", "update", "delete", "publish"
  description String?
  roles       RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Content Management Models
model BlogArticle {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  excerpt        String?
  contentHtml    String        @db.Text
  featuredImage  String?
  thumbnailImage String?
  readTime       String?       @default("5 MIN READ")
  status         ContentStatus @default(DRAFT)
  authorId       String
  author         User          @relation("AuthorArticles", fields: [authorId], references: [id])
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  tags           ArticleTag[]
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model CaseStudy {
  id                 String             @id @default(uuid())
  title              String
  slug               String             @unique
  clientName         String
  industry           String
  /// Overview paragraph shown in the detail hero
  summary            String             @db.Text
  /// Short challenge text shown on the listing card
  challenge          String             @db.Text
  /// Short solution text shown on the listing card
  solution           String             @db.Text
  /// Legacy free-text results (superseded by impactHtml / impactHighlights)
  results            String             @db.Text
  excerpt            String?            @db.Text
  thumbnailImage     String?
  featuredImage      String?
  featuredImageAlt   String?
  /// Extra images uploaded for use in the content (string[])
  galleryImages      Json?
  // ── Content sections (HTML is sanitized before rendering) ──
  challengeTitle     String?
  challengeHtml      String?            @db.Text
  /// string[]
  keyChallenges      Json?
  approachTitle      String?
  approachHtml       String?            @db.Text
  /// { title: string; desc: string }[]
  approachSteps      Json?
  solutionTitle      String?
  solutionHtml       String?            @db.Text
  /// { title: string; desc: string }[]
  solutionHighlights Json?
  impactTitle        String?
  impactHtml         String?            @db.Text
  /// { title: string; desc: string }[]
  impactHighlights   Json?
  /// Short impact pills on the listing card (string[])
  impacts            Json?
  /// Technology pills (string[])
  technologies       Json?
  /// Hand-picked related case study IDs (string[])
  relatedIds         Json?
  seoTitle           String?
  seoDescription     String?            @db.Text
  displayOrder       Int                @default(0)
  categoryId         String?
  category           CaseStudyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags               CaseStudyTagLink[]
  /// Owner (used for record-level access when the role lacks "manage")
  createdById        String?
  createdBy          User?              @relation("CaseStudyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  status             ContentStatus      @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, displayOrder])
}

model CaseStudyCategory {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  caseStudies CaseStudy[]
}

model CaseStudyTag {
  id          String             @id @default(uuid())
  name        String             @unique
  slug        String             @unique
  caseStudies CaseStudyTagLink[]
}

model CaseStudyTagLink {
  caseStudyId String
  tagId       String
  caseStudy   CaseStudy    @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  tag         CaseStudyTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([caseStudyId, tagId])
}

model Product {
  id               String         @id @default(uuid())
  /// Product name
  title            String
  slug             String         @unique
  /// Short description (listing cards)
  description      String         @db.Text
  /// Subtitle / tagline / category description
  badge            String?
  /// Logo / thumbnail
  logoUrl          String?
  /// Main banner / featured image
  featuredImage    String?
  featuredImageAlt String?
  /// Detailed description (rich text HTML, sanitized before rendering)
  contentHtml      String?        @db.Text
  features         Json? // Array of string features
  /// Technology tags (string[])
  technologies     Json?
  appExchange      String?
  websiteUrl       String?
  seoTitle         String?
  seoDescription   String?        @db.Text
  displayOrder     Int            @default(0)
  /// Active / Inactive switch (inactive products never show on the website)
  isActive         Boolean        @default(true)
  /// Existing rows predate publishing, so they default to PUBLISHED
  status           ContentStatus  @default(PUBLISHED)
  publishedAt      DateTime?
  images           ProductImage[]
  /// Owner (used for record-level access when the role lacks "manage")
  createdById      String?
  createdBy        User?          @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, isActive, displayOrder])
}

/// Gallery images of a product
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Category {
  id       String        @id @default(uuid())
  name     String        @unique
  slug     String        @unique
  articles BlogArticle[]
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  module    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ── Newsletter ──

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum SubscriptionSource {
  BLOG
  CASE_STUDY
  OTHER
}

model NewsletterSubscriber {
  id               String             @id @default(uuid())
  /// Stored lowercased + trimmed; one row per email
  email            String             @unique
  status           SubscriptionStatus @default(ACTIVE)
  /// Section the user subscribed from ("Blog" / "Case Studies")
  sourceType       SubscriptionSource @default(OTHER)
  /// Title of the blog post / case study, resolved server-side from the slug
  sourceTitle      String?
  sourceSlug       String?
  ipAddress        String?
  userAgent        String?
  /// Random token for the one-click unsubscribe link in emails
  unsubscribeToken String             @unique
  subscribedAt     DateTime           @default(now())
  unsubscribedAt   DateTime?
  /// Confirmation email delivery tracking
  emailSentAt      DateTime?
  emailError       String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([sourceType, sourceSlug])
  @@index([subscribedAt])
}

// ── Our Clients ──

model ClientCategory {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  /// Order of the filter pills on the Our Clients page (lower first)
  displayOrder Int      @default(0)
  clients      Client[]
}

model Client {
  id           String          @id @default(uuid())
  name         String
  logoUrl      String
  logoAlt      String?
  websiteUrl   String?
  description  String?         @db.Text
  categoryId   String?
  category     ClientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Order of the logo in the grid (lower first)
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  /// Featured clients are listed first under "All Clients"
  isFeatured   Boolean         @default(false)
  /// Owner (used for record-level access when the role lacks "manage")
  createdById  String?
  createdBy    User?           @relation("ClientCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isActive, displayOrder])
}

// ── Contact Settings (footer, Contact Us page, contact widgets) ──

model OfficeAddress {
  id           String   @id @default(uuid())
  /// Office location / country label, e.g. "India"
  location     String
  address      String   @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model ContactPhone {
  id           String   @id @default(uuid())
  /// e.g. "+91"
  countryCode  String
  /// As displayed, e.g. "9971126721"
  number       String
  /// Digits of countryCode + number, used to prevent duplicates
  digits       String   @unique
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model ContactEmail {
  id           String   @id @default(uuid())
  /// Stored lowercased
  email        String   @unique
  /// e.g. "Sales", "Support", "General Enquiry"
  type         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model SocialLink {
  id           String   @id @default(uuid())
  /// Platform key, e.g. "facebook", "x" or a custom slug; selects the icon
  platform     String   @unique
  /// Display name, e.g. "Facebook"
  name         String
  url          String
  /// Optional uploaded icon; when empty the built-in platform icon is used
  iconUrl      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// -- Contact Us form submissions (written by the public form, read by Admin only) --
model ContactSubmission {
  id             String   @id @default(uuid())
  name           String
  email          String
  /// Includes the country code, e.g. "919971126721"
  phone          String
  location       String?
  /// "Describe your idea"
  message        String   @db.Text
  /// "How did you hear about us?"
  referralSource String?
  /// Page the form was submitted from, e.g. "Home Page" or "/contact-us"
  pageName       String
  ipAddress      String?
  userAgent      String?
  submittedAt    DateTime @default(now())

  @@index([submittedAt])
  @@index([pageName])
}

// -- SMTP Configuration (Admin only, encrypted credentials) --
model SmtpSetting {
  id          String   @id @default(uuid())
  host        String
  port        Int      @default(587)
  username    String
  /// Stored encrypted with AES-256-GCM
  passwordEnc String   @db.Text
  /// Encryption mode: "TLS" (STARTTLS) | "SSL" (Implicit TLS) | "NONE"
  encryption  String   @default("TLS")
  fromEmail   String
  fromName    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// -- SMTP Delivery Failure Logs (Admin only) --
model SmtpFailureLog {
  id        String   @id @default(uuid())
  recipient String
  subject   String
  error     String   @db.Text
  host      String?
  port      Int?
  fromEmail String?
  source    String?  @default("application")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([recipient])
}

// ── Admin IP Whitelisting & Blacklisting ──
model AdminIpAddress {
  id          String   @id @default(uuid())
  ipAddress   String   @unique @map("ip_address")
  status      String   @default("allowed") // "allowed" | "blocked"
  description String?  @db.Text
  createdById String?  @map("created_by")
  createdBy   User?    @relation("IpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([ipAddress])
  @@map("admin_ip_addresses")
}


